{
  "scopeName": "source.lvt",
  "name": "Levitate",
  "fileTypes": ["lvt"],
  "patterns": [
    { "include": "#comment" },
    { "include": "#expression" },
    { "include": "#envVar" },
    { "include": "#variable" },
    { "include": "#string" },
    { "include": "#keyword" }
  ],
  "repository": {
    "comment": {
      "patterns": [
        {
          "name": "comment.line.number-sign.lvt",
          "match": "#.*$"
        }
      ]
    },
    "expression": {
      "patterns": [
        {
          "name": "meta.expression.lvt",
          "begin": "(?<!\\{)\\{(?!\\{)",
          "end": "(?<!\\})\\}(?!\\})",
          "beginCaptures": {
            "0": { "name": "punctuation.section.expression.begin.lvt" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.section.expression.end.lvt" }
          },
          "patterns": [
            { "include": "#envVar" },
            { "include": "#variable" },
            { "include": "#string" },
            { "include": "#keyword" },
            { "include": "#subcommand" }
          ]
        }
      ]
    },
    "envVar": {
      "patterns": [
        {
          "name": "variable.other.environment.lvt",
          "match": "%[\\w.]+%"
        }
      ]
    },
    "variable": {
      "patterns": [
        {
          "name": "variable.other.lvt",
          "match": "\\^[\\w]+\\^"
        }
      ]
    },
    "string": {
      "patterns": [
        {
          "name": "string.quoted.double.lvt",
          "begin": "\"",
          "end": "\"",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.lvt" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.lvt" }
          }
        }
      ]
    },
    "keyword": {
      "patterns": [
        {
          "name": "keyword.control.lvt",
          "match": "\\b(run|import|echo|input|var|env|copy|delete|sh|flat|verm|netfile|check|path|list|regex|not|ifr|pkgr|mrp|a2ogg|ase|psdcvt|pbrex|rrt|pw|exit|clear|help|proj|ext|task|reload|true|false|new)\\b"
        },
        {
          "name": "support.function.alias.lvt",
          "match": "\\b(makeCleanup|makeCopy|makePkg|psdCvt|pbrEx)\\b"
        },
        { "include": "#subcommand" }
      ]
    },
    "subcommand": {
      "patterns": [
        {
          "name": "keyword.other.subcommand.lvt",
          "match": "\\b(get|set|add|remove|list|restore|r|serialize|s|export|e|update|u|lock|unlock|clean|smajor|sminor|sfix|remapper|dir|isdir|match|replace|make|tear|zip|tar|start|stop|mono|info|chname|chroot|chout|show|create|lookup|commands|alias)\\b"
        }
      ]
    }
  }
}
